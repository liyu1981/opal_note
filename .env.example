# `pnpm dev` defaults to 0.0.0.0:7827; `pnpm start` uses the server default
# (127.0.0.1:7827). Override either with this variable.
OPALNOTE_BIND=127.0.0.1:7827
OPALNOTE_DATA_DIR=./data
OPALNOTE_QUERY_TIMEOUT_SECS=5
OPALNOTE_PLUGIN_TIMEOUT_SECS=5
# Set a token to require `Authorization: Bearer <token>` on every /api route.
# OPALNOTE_TOKEN=change-me
# RUST_LOG=opalnote=info,tower_http=warn
# OPALNOTE_DEV_CORS=false
