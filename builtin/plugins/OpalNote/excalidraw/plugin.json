{
  "id": "OpalNote/excalidraw",
  "title": "Excalidraw drawing",
  "description": "Draw and edit Excalidraw scenes.",
  "type": "viewer",
  "api": 1,
  "extensions": [
    "excalidraw"
  ],
  "entry": "viewer.html",
  "role": "editor",
  "inline": "read",
  "lightbox": "edit",
  "csp": {
    "connect-src": [
      "'self'"
    ],
    "font-src": [
      "'self'",
      "data:",
      "blob:",
      "https://esm.sh"
    ],
    "script-src": [
      "'self'",
      "'wasm-unsafe-eval'"
    ]
  },
  "sandbox": "same-origin"
}
