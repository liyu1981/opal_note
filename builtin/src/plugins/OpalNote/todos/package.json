{
  "name": "@opalnote/plugin-todos",
  "version": "1.0.0",
  "description": "Open tasks across the notebook.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../../../../scripts/build-builtins.mjs --only OpalNote/todos"
  },
  "opal_note": {
    "id": "OpalNote/todos",
    "title": "Open todos",
    "description": "Tasks not marked done or cancelled across this notebook.",
    "type": "server"
  },
  "opal_note_build": {
    "entry": "src/index.js",
    "target": "es2020",
    "minify": true
  }
}
